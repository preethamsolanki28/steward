# Steward environment. Copy to .env and fill in NEBIUS_API_KEY and TAVILY_API_KEY:
#   cp .env.example .env
# .env is gitignored; never commit real values. docker-compose.yml passes each
# variable only to the container that needs it. Hermes never receives
# NEBIUS_API_KEY, TAVILY_API_KEY or the SMTP credentials.

# --- steward-api: Nebius Token Factory (only the Privacy Shield proxy holds this key) ---
NEBIUS_API_KEY=
# Global URL only.
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_PRIMARY=nvidia/Nemotron-3_5-Lightning
MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b
MODEL_FALLBACK_2=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Set by DG-1 (docs/02 §12), e.g. low. Stays empty until DG-1 is recorded.
REASONING_EFFORT=

# --- steward-api: Tavily (web_search; without a key /api/health reports tavily: no_key) ---
TAVILY_API_KEY=

# --- steward-api: mail ---
# demo is the only mode in the MVP.
MAIL_MODE=demo
# SMTP_* are needed only when DEMO_MAIL_REDIRECT is set (team demo Gmail + App Password).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Optional: approved sends are also delivered here with subject prefix
# "[Steward demo → original@x.example]".
DEMO_MAIL_REDIRECT=
# Owner contact; excluded from all risk rules.
OWNER_EMAIL=maya@rao-consulting.example

# --- Shared secrets: `make up` writes random values here if they are empty ---
# Bearer for /v1/* (Hermes model.key_env). steward-api + hermes.
STEWARD_PROXY_KEY=
# Bearer for /mcp. steward-api + hermes.
STEWARD_MCP_TOKEN=
# Bearer for the Hermes API server. steward-api; hermes receives it as API_SERVER_KEY.
HERMES_API_KEY=

# --- steward-api: internal URLs and container paths ---
HERMES_API_URL=http://hermes:8642
STEWARD_DB_PATH=/data/steward.db
HERMES_DATA_DIR=/hermes-data
WORKSPACE_DIR=/workspace
# 1 = on startup also register a one-shot morning-brief-demo job due 2 minutes later (T5.2).
STEWARD_DEMO=0
# 1 = /api/* also accepts Host localhost:3000 (pnpm dev). Keep 0 otherwise.
STEWARD_DEV=0
# Proxy request cap; S1 only. 0 = off.
DAILY_REQUEST_CAP=0

# --- hermes ---
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY is not set here: docker-compose.yml passes HERMES_API_KEY to hermes as API_SERVER_KEY.
# Cron timezone for the 08:00 morning brief.
HERMES_TIMEZONE=Asia/Kolkata
# Must stay 10000: steward-api runs as UID 10000 and shares the memory files with hermes.
HERMES_UID=10000
HERMES_GID=10000

# --- build ---
NEXT_TELEMETRY_DISABLED=1
